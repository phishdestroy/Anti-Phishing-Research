# Example Environment Configuration
# Copy this file to .env and adjust it according to your needs

# ==============================================
# MAIN SERVER SETTINGS
# ==============================================

# Port for running the server (default is 5000)
PORT=5000

# Application mode
NODE_ENV=development

# Host to bind the server
HOST=0.0.0.0

# ==============================================
# DATABASE SETTINGS
# ==============================================

# PostgreSQL connection URL
# Format: postgresql://user:password@host:port/database_name
DATABASE_URL=postgresql://user:password@localhost:5432/antiphishing

# Alternative database settings (if using separate variables)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=antiphishing
DB_USER=user
DB_PASSWORD=password

# ==============================================
# SECURITY SETTINGS
# ==============================================

# Enable CORS (allow requests from other domains)
ENABLE_CORS=true

# Allowed domains for CORS (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Secret key for sessions (generate a random string)
SESSION_SECRET=your-super-secret-session-key-here

# Maximum session age in milliseconds (24 hours)
SESSION_MAX_AGE=86400000

# ==============================================
# LOGGING SETTINGS
# ==============================================

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# Enable logging to file
LOG_TO_FILE=false

# Log file path
LOG_FILE_PATH=./logs/app.log

# Maximum log file size in bytes
LOG_MAX_SIZE=10485760

# ==============================================
# WEBSOCKET SETTINGS
# ==============================================

# Path for WebSocket connections
WS_PATH=/api/ws

# WebSocket connection timeout in milliseconds
WS_TIMEOUT=30000

# ==============================================
# PROXY AND ANONYMIZATION SETTINGS
# ==============================================

# List of proxy servers (comma separated)
PROXY_LIST=http://proxy1.example.com:8080,http://proxy2.example.com:8080

# Enable proxy rotation
ENABLE_PROXY_ROTATION=false

# HTTP request timeout in milliseconds
HTTP_TIMEOUT=30000

# Maximum retry attempts for sending requests
MAX_RETRY_ATTEMPTS=3

# ==============================================
# VARIABLE GENERATION SETTINGS
# ==============================================

# Default length for generated random strings
DEFAULT_STRING_LENGTH=8

# Default length for generated numeric codes
DEFAULT_NUMERIC_LENGTH=6

# Default number of words in BIP39 phrases
DEFAULT_BIP39_WORD_COUNT=3

# ==============================================
# PERFORMANCE SETTINGS
# ==============================================

# Maximum payload size in bytes
MAX_PAYLOAD_SIZE=1048576

# Maximum number of variables in the payload
MAX_VARIABLES_COUNT=100

# Maximum number of log entries
MAX_LOG_ENTRIES=1000

# ==============================================
# DEVELOPMENT SETTINGS
# ==============================================

# Enable hot reload (only for development)
HOT_RELOAD=true

# Enable detailed error logs
VERBOSE_ERRORS=true

# Enable performance profiling
ENABLE_PROFILING=false

# ==============================================
# ADDITIONAL SETTINGS
# ==============================================

# Application name
APP_NAME=Anti-Phishing Research Tool

# Application version
APP_VERSION=1.0.0

# Contact email
CONTACT_EMAIL=admin@example.com

# Enable anonymous usage statistics collection
ENABLE_ANALYTICS=false

# ==============================================
# EXAMPLES OF CONFIGURATION FOR DIFFERENT ENVIRONMENTS
# ==============================================

# For local development:
# NODE_ENV=development
# DATABASE_URL=postgresql://dev:dev@localhost:5432/antiphishing_dev
# LOG_LEVEL=debug

# For testing:
# NODE_ENV=test
# DATABASE_URL=postgresql://test:test@localhost:5432/antiphishing_test
# LOG_LEVEL=warn

# For production:
# NODE_ENV=production
# DATABASE_URL=postgresql://prod_user:secure_password@prod_host:5432/antiphishing_prod
# LOG_LEVEL=error
# ENABLE_CORS=false
